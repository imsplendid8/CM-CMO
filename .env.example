# OAuth 팀 대시보드 환경 변수 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# Git에는 커밋하지 마세요 (민감 정보 포함)

# ===================================
# Claude API 설정 (필수)
# ===================================
# Anthropic 콘솔에서 발급받은 API 키
# https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Claude 모델 선택 (기본값: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# ===================================
# 서버 설정
# ===================================
# 포트 번호 (기본값: 3000)
PORT=3000

# 환경 (development | production)
NODE_ENV=development

# ===================================
# OAuth 설정 (선택사항 - 추후 구현)
# ===================================
# Google OAuth
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# GitHub OAuth
# GITHUB_CLIENT_ID=xxxxx
# GITHUB_CLIENT_SECRET=xxxxx

# ===================================
# 데이터베이스 설정 (선택사항 - 추후 구현)
# ===================================
# DATABASE_URL=

# ===================================
# 외부 서비스 연동 (선택사항)
# ===================================
# Naver Search Ads API (기존 프록시 사용)
# NAVER_AD_API_KEY=xxx
# NAVER_AD_SECRET=xxx
# NAVER_AD_CUSTOMER=xxx

# Telegram 브리프 (기존 봇)
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_CHAT_ID=xxx

# ===================================
# 개발 옵션
# ===================================
# 콘솔 로그 레벨 (debug | info | warn | error)
# LOG_LEVEL=info

# 캐시 활성화 (true | false)
# ENABLE_CACHE=true
# CACHE_TTL_SECONDS=3600
